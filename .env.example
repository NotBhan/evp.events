# ==============================================================================
# RAAS UTSAV 2026 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your local or deployment secrets.
# NEVER commit real credentials or .env.local to version control.
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (Authoritative Neon PostgreSQL)
# ==============================================================================
# [REQUIRED] [SERVER-ONLY]

DATABASE_URL=

# ==============================================================================
# 2. AUTHENTICATION & SESSION SECURITY
# ==============================================================================
# [OPTIONAL / RECOMMENDED] [SERVER-ONLY]

SESSION_SECRET=

# ==============================================================================
# 3. SCHEDULED MAINTENANCE & CRON
# ==============================================================================
# [REQUIRED FOR MAINTENANCE] [SERVER-ONLY]

CRON_SECRET=

# ==============================================================================
# 4. PAYMENT PROVIDER CONFIGURATION
# ==============================================================================
# [REQUIRED] [SERVER-ONLY]
# Active payment gateway provider selector.
# Supported future values:
#   - stripe    : Use Stripe Checkout / Elements
#   - razorpay  : Use Razorpay Checkout / Standard
PAYMENT_PROVIDER= # or stripe

# [REQUIRED] [SERVER-ONLY]
# Payment operational environment.
# Supported values:
#   - test        : Sandbox / Test mode (uses test API keys)
#   - production  : Live mode (uses live API keys)
PAYMENT_ENV=

# ==============================================================================
# 5. STRIPE CONFIGURATION
# ==============================================================================
# Required only when PAYMENT_PROVIDER=stripe

# [REQUIRED FOR STRIPE] [PUBLIC / CLIENT-SAFE]

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# [REQUIRED FOR STRIPE] [SERVER-ONLY]

STRIPE_SECRET_KEY=

# [REQUIRED FOR STRIPE] [SERVER-ONLY]

STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# 6. RAZORPAY CONFIGURATION
# ==============================================================================

# [REQUIRED FOR RAZORPAY] [SERVER-ONLY]

RAZORPAY_KEY_ID=

# [REQUIRED FOR RAZORPAY] [SERVER-ONLY]

RAZORPAY_KEY_SECRET=

# [REQUIRED FOR RAZORPAY] [SERVER-ONLY]

RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# 7. SECONDARY INTEGRATIONS (Google Apps Script / Sheets)
# ==============================================================================
# [SERVER-ONLY]
BOOKING_SHEETS_ENDPOINT=

# ==============================================================================
# 8. PUBLIC BOOKING WINDOW (runtime configuration — NOT secrets)
# ==============================================================================
# [REQUIRED] [SERVER-ONLY]
# Controls creation of NEW bookings only. ISO-8601 timestamps with an explicit
# timezone offset. BOOKING_OPEN_AT must be strictly earlier than BOOKING_CLOSE_AT.
# Open boundary is inclusive (now >= openAt); close boundary is exclusive (now < closeAt).
# Invalid / missing / unparsable / reversed values fail safe (new bookings closed).

BOOKING_OPEN_AT=
BOOKING_CLOSE_AT=

# ==============================================================================
# 9. ORGANISER ENTRY SYSTEM
# ==============================================================================
# [REQUIRED] [SERVER-ONLY] Dedicated QR entry token signing secret.
# Must be distinct from SESSION_SECRET, ORGANISER_SESSION_SECRET and payment secrets.

ENTRY_QR_SECRET=

# [REQUIRED] [SERVER-ONLY] Dedicated organiser session signing secret.
# Must be distinct from SESSION_SECRET and ENTRY_QR_SECRET.

ORGANISER_SESSION_SECRET=

# [OPTIONAL] [SERVER-ONLY] Comma-separated gate allowlist (configuration only, not an auth factor).
# Absent => any valid normalized gateId is allowed.

ORGANISER_GATE_IDS=
