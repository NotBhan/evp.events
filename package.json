    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:studio": "./scripts/run-with-ipv4.sh dotenv -e .env.local -- prisma studio",
    "db:inventory": "./scripts/run-with-ipv4.sh node --env-file=.env.local scripts/set_inventory.mjs"
