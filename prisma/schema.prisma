// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  FAILED
  PAID
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  FAILED
  SUCCEEDED
}

enum SheetSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum OrganiserRole {
  ENTRY_SCANNER
  ADMIN
}

model Organiser {
  id                  String        @id @default(cuid())
  name                String
  loginId             String        @unique @map("login_id")
  credentialHash      String        @map("credential_hash")
  role                OrganiserRole @default(ENTRY_SCANNER)
  gateId              String        @map("gate_id")
  active              Boolean       @default(true)
  hidden              Boolean       @default(false)
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  lastLoginAt         DateTime?     @map("last_login_at")

  @@map("organisers")
}

model Pass {
  id               String    @id @default(cuid())
  passType         String    @unique @map("pass_type")
  name             String
  price            Int       @default(0)
  totalQuantity    Int       @default(0) @map("total_quantity")
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  soldQuantity     Int       @default(0) @map("sold_quantity")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  bookings         Booking[]

  @@map("passes")
}

model Booking {
  id              String         @id @default(cuid())
  publicId        String         @unique @map("public_id")
  fullName        String         @map("full_name")
  email           String?
  phone           String
  city            String?        @default("Ranchi")
  passId          String         @map("pass_id")
  quantity        Int            @default(1)
  unitPrice       Int            @map("unit_price")
  totalAmount     Int            @map("total_amount")
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(NOT_STARTED) @map("payment_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  expiresAt       DateTime       @map("expires_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  confirmedAt       DateTime?      @map("confirmed_at")
  source            String         @default("web")

  sheetSyncStatus   SheetSyncStatus? @map("sheet_sync_status")
  sheetSyncedAt     DateTime?        @map("sheet_synced_at")
  sheetSyncAttempts Int              @default(0) @map("sheet_sync_attempts")
  sheetLastError    String?          @map("sheet_last_error")

  checkInStatus     CheckInStatus    @default(NOT_CHECKED_IN) @map("check_in_status")
  checkedInAt       DateTime?        @map("checked_in_at")
  checkedInBy       String?          @map("checked_in_by")
  checkedInById     String?          @map("checked_in_by_id")

  pass            Pass           @relation(fields: [passId], references: [id])
  paymentAttempts PaymentAttempt[]

  @@index([status])
  @@index([expiresAt])
  @@index([passId])
  @@index([phone, email])
  @@index([email])
  @@index([sheetSyncStatus])
  @@map("bookings")
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  bookingId         String               @map("booking_id")
  provider          String
  providerOrderId   String?              @map("provider_order_id")
  providerPaymentId String?              @map("provider_payment_id")
  amount            Int
  status            PaymentAttemptStatus @default(INITIATED)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([providerOrderId])
  @@map("payment_attempts")
}
